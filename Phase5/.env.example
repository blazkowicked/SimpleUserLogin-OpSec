# Copy to Phase5/.env and fill in. Never commit the real .env.

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.example.net/userlogin?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-hex-string
JWT_EXPIRES_IN=15m

# Email (Gmail SMTP). Optional in dev: emails are printed to the console instead.
SMTP_USER=your-app-address@example.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=App Name <your-app-address@example.com>

# Public site URL, no trailing slash
APP_URL=https://your-app.example.com

# Admin account for `npm run seed:admin`. No defaults.
# ADMIN_EMAIL must be a real inbox: admin login sends a verification code there.
# ADMIN_PASSWORD must meet the password rules (8+ chars, upper, lower, number, symbol).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudflare Turnstile (human check on signup, login, forgot password and admin login).
# Leave empty locally to use Cloudflare's always-pass test keys. On Vercel both are required,
# or those four forms reject every request.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
